# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# ─── Required for any deploy ──────────────────────────────────

# Supabase (required for progress sync and most APIs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# Google OAuth (required for sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Required for the quick-login (enrollment + password) feature ─

# Server-only signing key for password-session JWTs. Generate with:
#   openssl rand -base64 48
# Rotating this invalidates every quick-login session immediately.
PASSWORD_SESSION_SECRET=change-me-to-a-long-random-string

# ─── Optional ────────────────────────────────────────────────

# Comma-separated list of section names hidden from public surfaces
# (registration dropdown, IFS Connect, glimpse, weekly digest).
# Admin views still show them. Default: "Test Section"
HIDDEN_SECTIONS=Test Section

# Admin password fallback — accepted on admin endpoints when an admin
# isn't signed in via Google (legacy path; deprecate when rotating).
ADMIN_PASSWORD=

# Cron auth — bearer token /api/cron/weekly-digest expects.
CRON_SECRET=

# Public site URL — used for OG image base + sitemap. Defaults to
# the Vercel preview URL when unset.
NEXT_PUBLIC_SITE_URL=https://ifp105-notes.vercel.app

# Redis (Upstash via Vercel marketplace) for rate limits. Without
# these, rate limits fail-open (still functional, just unmetered).
KV_REDIS_URL=
REDIS_URL=
KV_URL=
